# 请勿把真实密钥提交到 Git。
OPENAI_API_KEY=
# 可选：本地语音使用 OpenAI 翻译时可单独填写；留空则复用 OPENAI_API_KEY。
# OPENAI_TEXT_API_KEY=
# OPENAI_TEXT_MODEL=gpt-5-mini

# 所有模型均可按服务商分别覆盖，以便后续升级或改用账户可用的模型。
TRANSCRIPTION_MODEL=gpt-transcribe
# 旧版 TEXT_MODEL 仍可读取；新配置请优先使用各服务的 *_TEXT_MODEL。
CLASSNOTE_READING_MODE=chinese

# 文本提供商：openai、deepseek 或 compatible。
# 本地语音识别不需要语音 API；翻译和整理可独立走 DeepSeek。
TEXT_PROVIDER=openai

# DeepSeek 示例：
# TEXT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_TEXT_MODEL=deepseek-v4-flash

# 任意 OpenAI Chat Completions 兼容服务示例：
# TEXT_PROVIDER=compatible
# COMPATIBLE_API_KEY=
# COMPATIBLE_TEXT_MODEL=qwen3:8b
# COMPATIBLE_BASE_URL=http://localhost:11434/v1
# 旧版 TEXT_API_KEY 仍可读取；用界面保存后会改用服务商独立的 Key 项。

# 数据默认只保存在本机。
CLASSNOTE_DB=data/classnote.db
CLASSNOTE_EXPORT_DIR=exports
# 可选：课堂期间在本机临时保留 WAV；正常完成后删除，中断时保留以便恢复。
CLASSNOTE_TEMP_AUDIO=false
CLASSNOTE_RETAIN_REVIEW_AUDIO=false

# 实时课堂每隔多少秒提交一次音频；建议 8～20 秒。
LIVE_CHUNK_SECONDS=10

# local：Windows 使用 RTX、Apple 芯片 Mac 使用 MLX；realtime：云端 WebSocket；chunked：云端分段兼容模式。
LIVE_MODE=local
LOCAL_TRANSCRIPTION_MODEL=distil-large-v3
MAC_TRANSCRIPTION_MODEL=mlx-community/whisper-large-v3-turbo
LOCAL_COMPUTE_TYPE=float16
LOCAL_REFRESH_MS=800
LIVE_TRANSCRIPTION_MODEL=gpt-live-transcribe
LIVE_TRANSCRIPTION_DELAY=low
